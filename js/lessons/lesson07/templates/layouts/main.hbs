<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Example App</title>

    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.cdnfonts.com/css/futura-pt" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="left">
            <a href="/">home</a> |
            <a href="/register">register</a> |
            <a href="/login">login</a>
        </div>

        <div class="right">
            <span id="userInfo"></span>
        </div>
    </nav>

    {{{body}}}
    
    {{#each scripts}}
        <script src="/{{this}}.js"></script>
    {{/each}}

    <script src="/cookie.js"></script>

    <script>
        const user = document.cookie.split(';').find(e => e.trimStart().startsWith('usr='))?.split('=')[1]

        document.getElementById('userInfo').innerHTML = user 
            ? `logged in as: <a href="/profile">${decodeURIComponent(user)}</a>`
            : `not logged in. <a href="/login">login</a>`
    </script>
</body>
</html>