<h1>register</h1>

<form method="post">
    <label>email: <input type="email" name="email"><i id="email-error" class="error-label"></i></label>

    <br>
    
    <label>password: <input type="password" name="pass1"><i class="error-label error-pass"></i></label>
    <label>confirm password: <input type="password" name="pass2"><i class="error-label error-pass"></i></label>

    <br>

    <label>country: <input type="text" name="country"><i class="error-label" id="country-error"></i></label>

    <div id="list"></div>

    <br>

    <input type="submit" value="submit">
</form>