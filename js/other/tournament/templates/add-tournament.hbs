<h1>add tournament</h1>

<form method="post" id="form">
    <label>Name<input type="text" name="name" required></label>

    <label>Players
        <label>
            <input type="checkbox" id="players-all">
            Wszyscy gracze
        </label>

        {{#each users}}
            {{#unless (eq this._id -1)}}
                <div>
                    <label>
                        <input type="checkbox" name="p-{{this._id}}" class="player-cb">
                        <a href="/players/{{this._id}}" target="_blank">{{this.name}} {{this.surname}}</a>
                    </label>
                </div>
            {{/unless}}
        {{/each}}
    </label>

    <label>Startlist
        <select name="crit">
            <option value="name">Name</option>
            <option value="rating" selected>Rating</option>
            <option value="age">Age</option>
        </select>
    </label>

    <i id="error"></i>

    <input type="submit" value="add">
    <a href="/">cancel</a>
</form>