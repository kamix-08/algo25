<link rel="stylesheet" href="/styles/card.css">
<link rel="stylesheet" href="/styles/add-tournament-page.css">

<main>
    <div class="card">
        <h1>add tournament</h1>
        
        <form method="post" id="form">

            <div class="splitCols">
                <div class="left">
                    <label><span>Name</span> <br> <input type="text" name="name" class="lInp" required></label>
                    <label><span>Players order</span> <br>
                        <select name="crit" class="lInp">
                            <option value="name">Name</option>
                            <option value="rating" selected>Rating</option>
                            <option value="age">Age</option>
                        </select>
                    </label>
                </div>
                
                <div class="right">
                    <label><span>Players</span> <br>
                        <label class="blue">
                            <input type="checkbox" id="players-all">Wszyscy gracze
                        </label>
                
                        <div class="scrDiv">
                            {{#each users}}
                                {{#unless this.deleted}}{{#unless (eq this._id -1)}}
                                    <div>
                                        <label class="cb">
                                            <input type="checkbox" name="p-{{this._id}}" class="player-cb">
                                            <a href="/players/{{this._id}}" class="no-style">{{this.name}} {{this.surname}}</a>
                                        </label>
                                    </div>
                                {{/unless}}{{/unless}}
                            {{/each}}
                        </div>
                    </label>
                    <i id="error"></i>
                </div>
            </div>
        
            <div class="btns">
                <input class="accept btn" type="submit" value="add">
                <a class="cancel btn" href="/tournaments">cancel</a>
            </div>
        </form>
    </div>
</main>