<h1>add tournament</h1>

<form method="post">
    <label>Name<input type="text" name="name"></label>

    <label>Players

        {{#each users}}
            <div>
                <label>
                    <input type="checkbox" name="p-{{this.id}}">
                    <a href="/players/{{this.id}}" target="_blank">{{this.name}} {{this.surname}}</a>
                </label>
            </div>
        {{/each}}
    </label>

    <label>Startlist
        <select name="crit">
            <option value="name">Name</option>
            <option value="rating" selected>Rating</option>
            <option value="age">Age</option>
        </select>
    </label>

    <input type="submit" value="add">
    <a href="/">cancel</a>
</form>