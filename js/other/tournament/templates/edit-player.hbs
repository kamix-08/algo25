<h1>edit player</h1>

<form method="post">
    <label>Name<input type="text" name="name" value="{{user.name}}" required></label>
    <label>Surname<input type="text" name="surname" value="{{user.surname}}" required></label>
    <label>Country<input type="text" name="country" value="{{user.country}}" required></label>
    <label>Age<input type="number" name="age" min="1" step="1" value="{{user.age}}" required></label>
    <label>Rating<input type="number" name="rating" min="0" step="1" value="{{user.rating}}" required></label>

    <input type="submit" value="update">
    <a href="/players/{{user._id}}">cancel</a>
</form>