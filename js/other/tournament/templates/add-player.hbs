<link rel="stylesheet" href="/forms.css">

<main>
    <h1>Add player</h1>
    
    <form method="post">
        <label><span>Name</span><input type="text" name="name" required></label>
        <label><span>Surname</span><input type="text" name="surname" required></label>
        <label><span>Country</span><input type="text" name="country" required></label>
        <label><span>Age</span><input type="number" name="age" min="1" step="1" required></label>
        <label><span>Rating</span><input type="number" name="rating" min="0" step="1" required></label>
    
        <div class="btns">
            <input class="accept btn" type="submit" value="add">
            <button class="cancel btn button" onclick="goBack()">cancel</button>
        </div>
    </form>
</main>