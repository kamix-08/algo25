<link rel="stylesheet" href="/styles/card.css">

<main>
    <div class="card">
        <h1>tournaments</h1>
        
        <div class="links">
            {{#each tournaments}}
                <div>
                    <a href="/tournaments/{{this._id}}">{{this.name}}</a>
                </div>
            {{/each}}
        </div>
    </div>
</main>