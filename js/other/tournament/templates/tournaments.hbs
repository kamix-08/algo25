<link rel="stylesheet" href="/card.css">
<link rel="stylesheet" href="/tournaments.css">

<main>
    <div class="card">
        <h1>Tournaments</h1>
        
        <div class="links">
            {{#each tournaments}}
                <div>
                    <a href="/tournaments/{{this._id}}">{{this.name}}</a>
                </div>
            {{/each}}
        </div>

        <a href="/tournaments/add" class="add">Add tournaments</a>
    </div>
</main>