<link rel="stylesheet" href="/players-page.css">
<link rel="stylesheet" href="/card.css">

<main>

    <div class="card">
        <h1>Players</h1>
        
        <div class="links">
            {{#each users}}{{#unless (eq _id -1)}}
                {{> player-link}}
            {{/unless}}{{/each}}
        </div>

        <a href="/players/add" class="add">Add players</a>
    </div>

</main>