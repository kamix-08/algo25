<link rel="stylesheet" href="/player-page.css">

<main>
    <div class="card">
        <div class="wrapDiv"><a href="/players" class="back">&#x2715;</a></div>
        <h1> {{user.name}} {{user.surname}} </h1>
        
        <div class="card-body">
            <div class="info">
                <p><b>Rating :</b> <span>{{user.rating}}</span></p>
                <p><b>Country :</b> <span>{{user.country}}</span></p>
                <p><b>Registered :</b> <span>{{user.date}}</span></p>
            </div>
            
            <div class="btns">
                <a href="/players/edit/{{user._id}}" class="edit">edit</a>
                <a href="/players/delete/{{user._id}}" class="delete">delete</a>
            </div>
        </div>
    </div>
</main>