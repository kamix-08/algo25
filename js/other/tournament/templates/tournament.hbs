<h1>{{tournament.name}}</h1>

<form method="post">
    {{#each tournament.rounds as | rounds |}}
        <div>
            {{#each rounds}}
                <div>
                    {{#player this.p1}}
                        <a href="/players/{{id}}" target="_blank">{{name}} {{surname}}</a>
                    {{/player}}

                    {{#player this.p2}}{{#unless (eq id -1)}}
                        <a href="/players/{{id}}" target="_blank">{{name}} {{surname}}</a>
                    {{/unless}}{{/player}}
    
                    <select name="b-{{@../index}}-{{@index}}">
                        {{#if (eq this.res -1)}}<option disabled selected>---</option>{{/if}}

                        {{#player this.p1}}
                            <option value="0" {{#if (eq ../this.res 0)}}selected{{/if}}>{{name}} {{surname}}</option>
                        {{/player}}

                        {{#player this.p2}}{{#unless (eq id -1)}}
                            <option value="1" {{#if (eq ../this.res 1)}}selected{{/if}}>{{name}} {{surname}}</option>
                        {{/unless}}{{/player}}
                    </select>
                </div>
            {{/each}}
        </div>
    {{/each}}
    
    <input type="submit" value="save">
</form>

{{#if tournament.winner}}
    {{#player tournament.winner}}<h2>Winner: <a href="/players/{{id}}">{{name}} {{surname}}</a></h2>{{/player}}
{{/if}}