<h1>{{tournament.name}}</h1>

<form method="post">
    <div class="bracket">{{#each tournament.rounds as | round |}}
        <div class="round">
            <h2 class="counter-round">Round </h2>
            
            {{#each round}}<div class="match-container">
                <div class="match">
                    {{#with (lookup @root.players this.p1)}}
                        {{> player-link}}
                    {{/with}}

                    {{#with (lookup @root.players this.p2)}}{{#unless (eq _id -1)}}
                        {{> player-link}}
                    {{else}}
                        <a>BYE</a>
                    {{/unless}}{{/with}}
                </div>

                <select name="b-{{@../index}}-{{@index}}" {{#unless @../last}}disabled{{/unless}}>
                    {{#if (eq this.res -1)}}<option disabled selected>---</option>{{/if}}

                    {{#with (lookup @root.players this.p1)}}
                        <option value="0" {{#if (eq ../this.res 0)}}selected{{/if}}>{{name}} {{surname}}</option>
                    {{/with}}

                    {{#with (lookup @root.players this.p2)}}{{#unless (eq _id -1)}}
                        <option value="1" {{#if (eq ../this.res 1)}}selected{{/if}}>{{name}} {{surname}}</option>
                    {{/unless}}{{/with}}
                </select>
            </div>
        {{/each}}</div>
    {{/each}}</div>
    
    <input type="submit" value="save">
</form>

{{#if tournament.winner}}
    {{#with (lookup players tournament.winner)}}<h2>Winner: {{> player-link}}</h2>{{/with}}
{{/if}}